-# =========================================================
-# TIKTOK CAPTION CHUNKS
-# =========================================================
-
-def words_to_chunks(words):
-
-    chunks = []
-
-    current = []
-
-    for word in words:
-
-        current.append(
-            word
-        )
-
-        current_text = " ".join(
-            item[
-                "text"
-            ]
-            for item in current
-        )
-
-        duration = (
-            current[-1]["end"]
-            - current[0]["start"]
-        )
-
-        should_finish = False
-
-        if len(
-            current
-        ) >= 4:
-
-            should_finish = True
-
-        elif (
-            len(current) >= 3
-            and duration >= 1.2
-        ):
-
-            should_finish = True
-
-        elif (
-            len(current) >= 2
-            and current[-1]["text"].endswith(
-                (
-                    ".",
-                    "!",
-                    "?",
-                    ",",
-                    ":",
-                    ";",
-                )
-            )
-        ):
-
-            should_finish = True
-
-        elif len(
-            current_text
-        ) >= 28:
-
-            should_finish = True
-
-        if not should_finish:
-
-            continue
-
-        chunks.append(
-            current
-        )
-
-        current = []
-
-    if current:
-
-        chunks.append(
-            current
-        )
-
-    return chunks
-
