-def candidate_allowed(
-    candidate,
-    selected,
-    history,
-    minimum_score=None
-):
-
-    if candidate.get(
-        "boring",
-        False
-    ):
-
-        print(
-            "LANGWEILIGER CLIP BLOCKIERT: "
