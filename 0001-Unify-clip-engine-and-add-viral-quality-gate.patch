-
-    parts = []
-
-    for word in words:
-
-        duration = max(
-            0.08,
-            word[
-                "end"
-            ]
-            - word[
-                "start"
-            ]
-        )
-
-        centiseconds = max(
-            8,
-            int(
-                duration
-                * 100
-            )
-        )
-
-        text = escape_ass_text(
-            word[
-                "text"
-            ]
-        )
-
-        parts.append(
-            "{\\kf"
-            + str(
-                centiseconds
-            )
-            + "}"
-            + text
-        )
-
-    return " ".join(
-        parts
-    )
